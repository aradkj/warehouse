# Arad Warehouse Platform Frontend Configuration

# Base URL for API requests.
# In production, when served from the same origin by FastAPI, leave empty or '/v1'.
# In local development with Vite dev server proxying to FastAPI on port 8000, leave as '/v1'.
VITE_API_BASE_URL=/v1

# Target backend server for Vite development server proxy
VITE_BACKEND_TARGET=http://127.0.0.1:8000
