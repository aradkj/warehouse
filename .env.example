# ---------------------------------------------------------------------------
# Arad Platform Runtime Configuration (.env.example)
# Production hardening template - replace placeholders with secure secrets.
# ---------------------------------------------------------------------------

# PostgreSQL Database (System of Record)
# Dedicated least-privilege runtime role (NOBYPASSRLS, NOSUPERUSER)
ARAD_DATABASE_URL=postgresql+asyncpg://arad_app:YOUR_SECURE_APP_DB_PASSWORD@postgres:5432/arad
# Administrative/migration role (runs alembic migrations)
ARAD_ADMIN_DATABASE_URL=postgresql+asyncpg://arad:YOUR_SECURE_ADMIN_DB_PASSWORD@postgres:5432/arad
ARAD_TEST_DATABASE_URL=postgresql+asyncpg://arad:YOUR_SECURE_DB_PASSWORD@postgres:5432/arad_test

# Connection Pool Settings
ARAD_DB_POOL_SIZE=20
ARAD_DB_MAX_OVERFLOW=20
ARAD_DB_POOL_TIMEOUT_SECONDS=10.0
ARAD_DB_POOL_RECYCLE_SECONDS=1800
ARAD_DB_STATEMENT_TIMEOUT_MS=15000
ARAD_DB_ECHO=false

# Runtime Environment
ARAD_ENVIRONMENT=production
ARAD_LOG_LEVEL=INFO
ARAD_LOG_JSON=true
ARAD_API_PREFIX=/v1

# Authentication & Security (Phase 4 / 5)
# In production, must be at least 32 cryptographically random characters:
# e.g. python -c "import secrets; print(secrets.token_hex(32))"
ARAD_AUTH_JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_SECRET_KEY_BEFORE_PRODUCTION_USE
ARAD_AUTH_JWT_ALGORITHM=HS256
ARAD_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
ARAD_AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
ARAD_AUTH_REQUIRED=true

# Messaging & Outbox (RabbitMQ)
ARAD_RABBITMQ_URL=amqp://arad:YOUR_SECURE_RABBITMQ_PASSWORD@rabbitmq:5672//
ARAD_CELERY_BROKER_URL=amqp://arad:YOUR_SECURE_RABBITMQ_PASSWORD@rabbitmq:5672//
ARAD_RABBITMQ_EXCHANGE=arad.events
ARAD_RABBITMQ_PREFETCH=10

# Caching & Distributed Locks (Redis)
ARAD_REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
ARAD_REDIS_MAX_CONNECTIONS=50
ARAD_REDIS_KEY_PREFIX=arad
ARAD_REDIS_DEFAULT_TTL_SECONDS=300

# Search & Projections (Elasticsearch)
ARAD_ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ARAD_ELASTICSEARCH_TIMEOUT_SECONDS=10.0
ARAD_ELASTICSEARCH_MAX_RETRIES=3

# Business Policy Knobs
ARAD_UNAVAILABLE_STOCK_POLICY=BACKORDER
ARAD_RESERVATION_TTL_SECONDS=1800
ARAD_MAX_RESERVATION_TTL_SECONDS=86400
ARAD_IDEMPOTENCY_RETENTION_SECONDS=604800
