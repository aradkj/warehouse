# ---------------------------------------------------------------------------
# Phase 1 runtime configuration (see src/bootstrap/config.py for the full list)
# ---------------------------------------------------------------------------

# PostgreSQL is the system of record.
ARAD_DATABASE_URL=postgresql+asyncpg://arad:arad@localhost:5432/arad

# Connection pool
ARAD_DB_POOL_SIZE=10
ARAD_DB_MAX_OVERFLOW=10
ARAD_DB_POOL_TIMEOUT_SECONDS=10
ARAD_DB_POOL_RECYCLE_SECONDS=1800
ARAD_DB_STATEMENT_TIMEOUT_MS=15000
ARAD_DB_ECHO=false

# Runtime
ARAD_ENVIRONMENT=local
ARAD_LOG_LEVEL=INFO
ARAD_LOG_JSON=true
ARAD_API_PREFIX=/v1

# Request-scoped policy used when the RequestContext is built.
ARAD_DEFAULT_LOCALITY=local

# Reservation defaults (business policy; expiring reservations is a Phase 2 worker job,
# but reservations always carry an expiry timestamp).
ARAD_RESERVATION_TTL_SECONDS=1800
ARAD_MAX_RESERVATION_TTL_SECONDS=86400

# Idempotency retention (records are kept for at least this long; cleanup is Phase 2).
ARAD_IDEMPOTENCY_RETENTION_SECONDS=604800

# Test database used by the PostgreSQL-backed test suites.
ARAD_TEST_DATABASE_URL=postgresql+asyncpg://arad:arad@localhost:5432/arad_test

# Redis caching & distributed locks (Phase 3)
ARAD_REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
ARAD_REDIS_MAX_CONNECTIONS=50
ARAD_REDIS_SOCKET_TIMEOUT_SECONDS=2.0
ARAD_REDIS_CONNECT_TIMEOUT_SECONDS=2.0
ARAD_REDIS_KEY_PREFIX=arad
ARAD_REDIS_DEFAULT_TTL_SECONDS=300
ARAD_REDIS_NEGATIVE_TTL_SECONDS=30
ARAD_REDIS_LOCK_TIMEOUT_SECONDS=5.0

# Elasticsearch search & projections (Phase 3)
ARAD_ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_URL=http://localhost:9200
ARAD_ELASTICSEARCH_TIMEOUT_SECONDS=10.0
ARAD_ELASTICSEARCH_MAX_RETRIES=3

